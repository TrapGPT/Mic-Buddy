# Copy to .env and adjust. Never commit .env.

# Local Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/micbuddy?schema=public"

# Clerk — from https://dashboard.clerk.com (Keys). Required for auth UI / API.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Optional: explicit URLs (helps embedded <SignIn /> / <SignUp /> routing)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"
